<?xml version="1.0" encoding="utf-8"?>
<!--
  Redirige toute URL qui ne correspond pas a un fichier ou dossier reel vers
  index.html, pour que Vue Router (mode history) gere la route lui-meme.
  Sans ca, recharger la page sur une route autre que la racine (ex: /hr,
  /hr/employees) renvoie une 404 IIS au lieu de servir l'application.

  Necessite le module IIS "URL Rewrite" (gratuit, tres repandu) installe sur
  le serveur qui sert ce site.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <!-- .webp absent du mapping MIME par defaut sur beaucoup de versions
           d'IIS (contrairement a .png/.jpg) : IIS renvoie une 404 sur le
           fichier meme s'il est bien present sur le disque. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
